{
  "_comment": "口播视频的字幕样式：每个主题选一个预设（pill 卡片 / sticker 描边贴纸 / block 硬框 / ink 无框墨字 / marker 荧光笔 / cinema 电影字幕 / glass 毛玻璃），再用 --cap-* 变量取主题自己的颜色和字体。预设在 layouts/video.css。没列出的主题用 default。",
  "default": {
    "style": "pill"
  },
  "apple-hark": {
    "style": "pill",
    "vars": {
      "--cap-bg": "#FFFFFF",
      "--cap-fg": "#1D1D1F",
      "--cap-key": "#0071E3",
      "--cap-radius": "999px",
      "--cap-shadow": "0 12px 32px -18px rgba(30,45,70,.4)"
    }
  },
  "apple-hark-dark": {
    "style": "pill",
    "vars": {
      "--cap-bg": "rgba(28,28,30,.88)",
      "--cap-border": "1px solid rgba(245,245,247,.16)",
      "--cap-fg": "#F5F5F7",
      "--cap-key": "#0A84FF",
      "--cap-radius": "999px",
      "--cap-shadow": "0 12px 32px -18px rgba(0,0,0,.7)"
    }
  },
  "apple-hark-warm": {
    "style": "pill",
    "vars": {
      "--cap-bg": "#FFFDF9",
      "--cap-border": "1px solid rgba(41,37,33,.10)",
      "--cap-fg": "#292521",
      "--cap-key": "#A6683C",
      "--cap-radius": "999px",
      "--cap-shadow": "0 12px 32px -18px rgba(60,45,30,.35)"
    }
  },
  "apple-flow": {
    "style": "ink",
    "vars": {
      "--cap-weight": "600",
      "--cap-track": ".04em",
      "--cap-key": "#0071E3"
    }
  },
  "hark-noir": {
    "style": "pill",
    "vars": {
      "--cap-bg": "rgba(10,18,32,.90)",
      "--cap-border": "1px solid rgba(143,180,255,.34)",
      "--cap-fg": "#F2F5FB",
      "--cap-key": "#8FB4FF",
      "--cap-radius": "999px",
      "--cap-shadow": "0 10px 30px -14px rgba(0,0,0,.75)"
    }
  },
  "paper-editorial": {
    "style": "ink",
    "vars": {
      "--cap-weight": "700",
      "--cap-track": ".06em",
      "--cap-key": "#B23A2A"
    }
  },
  "signal-swiss": {
    "style": "block",
    "vars": {
      "--cap-bg": "#111111",
      "--cap-fg": "#FFFFFF",
      "--cap-key": "#D8390E",
      "--cap-radius": "0",
      "--cap-shadow": "none"
    }
  }
}
